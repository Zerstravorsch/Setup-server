```bash
#!/bin/bash

# ============================================================
# SETUP SERVER E-OFFICE
# Target:
#   Ubuntu 20.04
#   Apache 2.4
#   PHP 7.4
#   MariaDB 10.4
#
# Webroot:
#   /home/USERNAME/public_html
# ============================================================

set -u

# ------------------------------------------------------------
# WARNA
# ------------------------------------------------------------
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

# ------------------------------------------------------------
# FUNCTION
# ------------------------------------------------------------

log() {
    echo -e "${BLUE}[INFO]${NC} $1"
}

success() {
    echo -e "${GREEN}[OK]${NC} $1"
}

warning() {
    echo -e "${YELLOW}[WARNING]${NC} $1"
}

error() {
    echo -e "${RED}[ERROR]${NC} $1"
}

die() {
    error "$1"
    exit 1
}

check_root() {
    if [[ "$EUID" -ne 0 ]]; then
        die "Script harus dijalankan sebagai root."
    fi
}

check_os() {

    if [[ ! -f /etc/os-release ]]; then
        die "Tidak dapat mendeteksi sistem operasi."
    fi

    source /etc/os-release

    echo ""
    echo "OS terdeteksi:"
    echo "  ID      : $ID"
    echo "  VERSION : $VERSION_ID"
    echo ""

    if [[ "$ID" != "ubuntu" ]]; then
        die "Script ini khusus Ubuntu."
    fi

    if [[ "$VERSION_ID" != "20.04" ]]; then
        warning "Script ini dirancang untuk Ubuntu 20.04."
        warning "OS Anda: Ubuntu $VERSION_ID"
        echo ""

        read -p "Tetap lanjutkan? (y/n): " CONTINUE

        if [[ "$CONTINUE" != "y" ]]; then
            exit 1
        fi
    fi
}

apt_update_safe() {

    log "Updating repository..."

    if apt-get update; then
        success "Repository berhasil diperbarui."
        return 0
    fi

    warning "apt update gagal."

    echo ""
    echo "Mencoba repository Ubuntu alternatif..."
    echo ""

    # Backup sources.list
    cp /etc/apt/sources.list \
       /etc/apt/sources.list.backup.$(date +%Y%m%d%H%M%S)

    # Repository Ubuntu utama
    cat > /etc/apt/sources.list <<EOF
deb http://archive.ubuntu.com/ubuntu focal main restricted universe multiverse
deb http://archive.ubuntu.com/ubuntu focal-updates main restricted universe multiverse
deb http://archive.ubuntu.com/ubuntu focal-security main restricted universe multiverse
deb http://archive.ubuntu.com/ubuntu focal-backports main restricted universe multiverse
EOF

    if apt-get update; then
        success "Repository alternatif berhasil digunakan."
        return 0
    fi

    warning "archive.ubuntu.com gagal."

    echo "Mencoba mirror Ubuntu Indonesia..."

    cat > /etc/apt/sources.list <<EOF
deb http://id.archive.ubuntu.com/ubuntu focal main restricted universe multiverse
deb http://id.archive.ubuntu.com/ubuntu focal-updates main restricted universe multiverse
deb http://id.archive.ubuntu.com/ubuntu focal-security main restricted universe multiverse
deb http://id.archive.ubuntu.com/ubuntu focal-backports main restricted universe multiverse
EOF

    if apt-get update; then
        success "Mirror Indonesia berhasil digunakan."
        return 0
    fi

    die "Semua repository Ubuntu gagal."
}

install_package() {

    local PACKAGE="$1"

    log "Installing $PACKAGE ..."

    if apt-get install -y "$PACKAGE"; then
        success "$PACKAGE berhasil diinstall."
        return 0
    fi

    error "Gagal menginstall $PACKAGE."

    return 1
}

# ------------------------------------------------------------
# INPUT
# ------------------------------------------------------------

clear

echo "========================================"
echo "     SETUP SERVER E-OFFICE"
echo "========================================"
echo ""
echo "Target:"
echo "  Apache    : 2.4"
echo "  PHP       : 7.4"
echo "  PHP-FPM   : 7.4"
echo "  MariaDB   : 10.4"
echo "  Ubuntu    : 20.04"
echo ""

read -p "Masukkan nama domain (contoh: eoffice.penajamkab.go.id): " DOMAIN

read -p "Masukkan nama user Linux (contoh: eoffice): " USERNAME

read -p "Masukkan port SSH baru (contoh: 2110): " SSHPORT

# ------------------------------------------------------------
# VALIDASI INPUT
# ------------------------------------------------------------

if [[ -z "$DOMAIN" ]]; then
    die "Domain tidak boleh kosong."
fi

if [[ -z "$USERNAME" ]]; then
    die "Username tidak boleh kosong."
fi

if [[ -z "$SSHPORT" ]]; then
    die "Port SSH tidak boleh kosong."
fi

if ! [[ "$SSHPORT" =~ ^[0-9]+$ ]]; then
    die "Port SSH harus berupa angka."
fi

if (( SSHPORT < 1024 || SSHPORT > 65535 )); then
    die "Port SSH harus berada antara 1024-65535."
fi

WEBROOT="/home/$USERNAME/public_html"

echo ""
echo "========================================"
echo "          RINGKASAN INPUT"
echo "========================================"
echo "Domain       : $DOMAIN"
echo "Username     : $USERNAME"
echo "Web Root     : $WEBROOT"
echo "SSH Port     : $SSHPORT"
echo "========================================"
echo ""

read -p "Lanjutkan instalasi? (y/n): " KONFIRMASI

if [[ "$KONFIRMASI" != "y" ]]; then
    echo "Dibatalkan."
    exit 0
fi

# ------------------------------------------------------------
# ROOT & OS
# ------------------------------------------------------------

check_root
check_os

# ------------------------------------------------------------
# UPDATE SYSTEM
# ------------------------------------------------------------

echo ""
echo "========================================"
echo "     UPDATE SYSTEM"
echo "========================================"

apt_update_safe

apt-get upgrade -y

# ------------------------------------------------------------
# INSTALL BASIC PACKAGE
# ------------------------------------------------------------

log "Installing basic packages..."

apt-get install -y \
    curl \
    wget \
    ca-certificates \
    gnupg \
    lsb-release \
    software-properties-common \
    apt-transport-https \
    unzip \
    nano \
    sudo

success "Basic packages selesai."

# ------------------------------------------------------------
# SSH
# ------------------------------------------------------------

echo ""
echo "========================================"
echo "          CONFIGURE SSH"
echo "========================================"

install_package openssh-server || die "SSH gagal diinstall."

systemctl enable ssh
systemctl start ssh

# Backup konfigurasi SSH
cp /etc/ssh/sshd_config \
   /etc/ssh/sshd_config.backup.$(date +%Y%m%d%H%M%S)

# Jika Port sudah ada
if grep -qE "^Port[[:space:]]+" /etc/ssh/sshd_config; then

    sed -i \
        "s/^Port[[:space:]].*/Port $SSHPORT/" \
        /etc/ssh/sshd_config

else

    echo "Port $SSHPORT" >> /etc/ssh/sshd_config

fi

# Validasi konfigurasi SSH
if sshd -t; then

    systemctl restart ssh

    success "SSH berhasil dikonfigurasi pada port $SSHPORT."

else

    error "Konfigurasi SSH tidak valid."

    warning "Mengembalikan konfigurasi SSH..."

    cp /etc/ssh/sshd_config.backup.* \
       /etc/ssh/sshd_config 2>/dev/null || true

    systemctl restart ssh

    die "Instalasi dihentikan karena konfigurasi SSH bermasalah."

fi

# ------------------------------------------------------------
# USER
# ------------------------------------------------------------

echo ""
echo "========================================"
echo "        CREATE LINUX USER"
echo "========================================"

if id "$USERNAME" &>/dev/null; then

    warning "User $USERNAME sudah ada."

else

    adduser --disabled-password --gecos "" "$USERNAME"

    success "User $USERNAME berhasil dibuat."

fi

# ------------------------------------------------------------
# APACHE
# ------------------------------------------------------------

echo ""
echo "========================================"
echo "          INSTALL APACHE"
echo "========================================"

install_package apache2 || die "Apache gagal diinstall."

systemctl enable apache2
systemctl start apache2

# Apache modules
a2enmod rewrite
a2enmod proxy
a2enmod proxy_fcgi
a2enmod setenvif
a2enmod headers
a2enmod ssl

success "Apache berhasil diinstall."

# ------------------------------------------------------------
# WEBROOT
# ------------------------------------------------------------

echo ""
echo "========================================"
echo "          CREATE WEB ROOT"
echo "========================================"

mkdir -p "$WEBROOT"

# Ownership
chown -R "$USERNAME:$USERNAME" "/home/$USERNAME"

# Permission directory user
chmod 755 "/home/$USERNAME"
chmod 755 "$WEBROOT"

success "Web root dibuat:"
echo "$WEBROOT"

# ------------------------------------------------------------
# MAINTENANCE PAGE
# ------------------------------------------------------------

log "Creating initial index page..."

cat > "$WEBROOT/index.php" <<EOF
<?php

echo "<h1>E-Office Server Ready</h1>";
echo "<p>Domain: $DOMAIN</p>";
echo "<p>Server successfully configured.</p>";

?>
EOF

chown "$USERNAME:$USERNAME" "$WEBROOT/index.php"

# ------------------------------------------------------------
# PHP 7.4
# ------------------------------------------------------------

echo ""
echo "========================================"
echo "          INSTALL PHP 7.4"
echo "========================================"

# Ubuntu 20.04 menyediakan PHP 7.4.
# Pastikan repository universe aktif.

add-apt-repository -y universe >/dev/null 2>&1 || true

apt-get update

PHP_PACKAGES="\
php7.4 \
php7.4-cli \
php7.4-fpm \
php7.4-common \
php7.4-mysql \
php7.4-xml \
php7.4-mbstring \
php7.4-curl \
php7.4-zip \
php7.4-gd \
php7.4-bcmath \
php7.4-intl \
php7.4-soap \
php7.4-opcache \
php7.4-readline"

if ! apt-get install -y $PHP_PACKAGES; then

    error "PHP 7.4 gagal diinstall."

    echo ""
    echo "Periksa repository Ubuntu:"
    apt-cache policy php7.4

    die "Instalasi PHP dihentikan."

fi

# Enable PHP-FPM
systemctl enable php7.4-fpm
systemctl restart php7.4-fpm

# Apache PHP-FPM configuration
a2enconf php7.4-fpm

systemctl restart apache2

success "PHP 7.4 berhasil diinstall."

# ------------------------------------------------------------
# PHP CONFIGURATION
# ------------------------------------------------------------

log "Configuring PHP 7.4..."

PHP_INI="/etc/php/7.4/fpm/php.ini"

if [[ -f "$PHP_INI" ]]; then

    cp "$PHP_INI" \
       "$PHP_INI.backup.$(date +%Y%m%d%H%M%S)"

    # Basic E-Office settings
    sed -i 's/^memory_limit = .*/memory_limit = 256M/' "$PHP_INI"
    sed -i 's/^upload_max_filesize = .*/upload_max_filesize = 100M/' "$PHP_INI"
    sed -i 's/^post_max_size = .*/post_max_size = 100M/' "$PHP_INI"
    sed -i 's/^max_execution_time = .*/max_execution_time = 300/' "$PHP_INI"
    sed -i 's/^max_input_time = .*/max_input_time = 300/' "$PHP_INI"

fi

systemctl restart php7.4-fpm

# ------------------------------------------------------------
# APACHE VIRTUAL HOST
# ------------------------------------------------------------

echo ""
echo "========================================"
echo "        CREATE APACHE VHOST"
echo "========================================"

VHOST="/etc/apache2/sites-available/$DOMAIN.conf"

cat > "$VHOST" <<EOF
<VirtualHost *:80>

    ServerName $DOMAIN
    DocumentRoot $WEBROOT

    <Directory $WEBROOT>

        Options Indexes FollowSymLinks

        AllowOverride All

        Require all granted

    </Directory>

    <FilesMatch \.php$>

        SetHandler "proxy:unix:/run/php/php7.4-fpm.sock|fcgi://localhost/"

    </FilesMatch>

    DirectoryIndex index.php index.html

    ErrorLog \${APACHE_LOG_DIR}/$DOMAIN-error.log

    CustomLog \${APACHE_LOG_DIR}/$DOMAIN-access.log combined

</VirtualHost>
EOF

# Disable default site
a2dissite 000-default.conf >/dev/null 2>&1 || true

# Enable domain
a2ensite "$DOMAIN.conf"

# Test Apache configuration
if apache2ctl configtest; then

    systemctl reload apache2

    success "VirtualHost $DOMAIN berhasil dibuat."

else

    error "Konfigurasi Apache tidak valid."

    a2dissite "$DOMAIN.conf" >/dev/null 2>&1 || true

    die "VirtualHost gagal dibuat."

fi

# ------------------------------------------------------------
# MARIADB 10.4.27
# ------------------------------------------------------------

echo ""
echo "========================================"
echo "        INSTALL MARIADB 10.4.27"
echo "========================================"

MARIADB_VERSION="10.4.27"
MARIADB_REPO="http://archive.mariadb.org/mariadb-10.4.27/repo/ubuntu"

# Backup existing MariaDB repository
if ls /etc/apt/sources.list.d/*mariadb*.list >/dev/null 2>&1; then

    mkdir -p /root/mariadb-repo-backup

    cp /etc/apt/sources.list.d/*mariadb*.list \
       /root/mariadb-repo-backup/ 2>/dev/null || true

fi

# Remove old MariaDB repository files
rm -f /etc/apt/sources.list.d/mariadb.list
rm -f /etc/apt/sources.list.d/MariaDB.list

# Install GPG tools
apt-get install -y gnupg

# Import MariaDB signing key
log "Installing MariaDB repository signing key..."

curl -fsSL \
    "https://mariadb.org/mariadb_release_signing_key.asc" \
    | gpg --dearmor \
    -o /usr/share/keyrings/mariadb-archive-keyring.gpg

if [[ ! -f /usr/share/keyrings/mariadb-archive-keyring.gpg ]]; then
    die "GPG key MariaDB gagal dibuat."
fi

# Add MariaDB 10.4.27 archive repository
cat > /etc/apt/sources.list.d/mariadb-10.4.list <<EOF
deb [signed-by=/usr/share/keyrings/mariadb-archive-keyring.gpg] $MARIADB_REPO focal main
EOF

# Update repository
if ! apt-get update; then

    error "Repository MariaDB 10.4.27 gagal."

    echo ""
    echo "Mencoba HTTP archive..."

    sed -i \
        's|http://archive.mariadb.org|https://archive.mariadb.org|' \
        /etc/apt/sources.list.d/mariadb-10.4.list

    if ! apt-get update; then
        die "Repository MariaDB 10.4.27 tidak dapat diakses."
    fi

fi

# Cek package
echo ""
log "Checking MariaDB package..."

apt-cache policy mariadb-server

# Exact package version
MARIADB_PACKAGE_VERSION="1:10.4.27+maria~focal"

if apt-cache policy mariadb-server | grep -q "$MARIADB_PACKAGE_VERSION"; then

    success "MariaDB 10.4.27 ditemukan di repository."

else

    error "MariaDB 10.4.27 tidak ditemukan."

    echo ""
    echo "Versi MariaDB yang tersedia:"
    apt-cache policy mariadb-server

    die "Instalasi MariaDB dihentikan agar versi yang salah tidak terinstall."

fi

# Install exact version
log "Installing MariaDB 10.4.27..."

if ! apt-get install -y \
    mariadb-server="$MARIADB_PACKAGE_VERSION" \
    mariadb-client="$MARIADB_PACKAGE_VERSION"; then

    die "MariaDB 10.4.27 gagal diinstall."
fi

# Prevent automatic upgrade to another MariaDB version
apt-mark hold mariadb-server mariadb-client

systemctl enable mariadb
systemctl restart mariadb

success "MariaDB 10.4.27 berhasil diinstall."

# ------------------------------------------------------------
# DATABASE SECURITY
# ------------------------------------------------------------

echo ""
echo "========================================"
echo "        MARIADB STATUS"
echo "========================================"

if systemctl is-active --quiet mariadb; then

    success "MariaDB service aktif."

else

    error "MariaDB service tidak aktif."

    systemctl status mariadb --no-pager

    die "MariaDB gagal berjalan."

fi

# ------------------------------------------------------------
# PHP VERSION CHECK
# ------------------------------------------------------------

echo ""
echo "========================================"
echo "          VERSION CHECK"
echo "========================================"

PHP_VERSION=$(php -r 'echo PHP_VERSION;' 2>/dev/null || echo "UNKNOWN")

APACHE_VERSION=$(apache2 -v 2>/dev/null | head -n 1)

MARIADB_VERSION_OUTPUT=$(mariadb --version 2>/dev/null || echo "UNKNOWN")

echo ""
echo "PHP:"
echo "$PHP_VERSION"

echo ""
echo "Apache:"
echo "$APACHE_VERSION"

echo ""
echo "MariaDB:"
echo "$MARIADB_VERSION_OUTPUT"

echo ""

# ------------------------------------------------------------
# VERIFY PHP 7.4
# ------------------------------------------------------------

if [[ "$PHP_VERSION" == 7.4.* ]]; then

    success "PHP 7.4 terdeteksi."

else

    error "PHP bukan versi 7.4."

fi

# ------------------------------------------------------------
# VERIFY MARIADB 10.4
# ------------------------------------------------------------

if echo "$MARIADB_VERSION_OUTPUT" | grep -q "10.4."; then

    success "MariaDB 10.4 terdeteksi."

else

    error "MariaDB bukan versi 10.4."

fi

# ------------------------------------------------------------
# PERMISSION
# ------------------------------------------------------------

echo ""
echo "========================================"
echo "          SET PERMISSION"
echo "========================================"

chown -R "$USERNAME:$USERNAME" "/home/$USERNAME"

find "/home/$USERNAME" \
    -type d \
    -exec chmod 755 {} \;

find "/home/$USERNAME" \
    -type f \
    -exec chmod 644 {} \;

# public_html executable
chmod 755 "$WEBROOT"

success "Permission berhasil diset."

# ------------------------------------------------------------
# FINAL TEST
# ------------------------------------------------------------

echo ""
echo "========================================"
echo "          FINAL TEST"
echo "========================================"

# PHP-FPM
if systemctl is-active --quiet php7.4-fpm; then
    success "PHP-FPM 7.4 : RUNNING"
else
    error "PHP-FPM 7.4 : FAILED"
fi

# Apache
if systemctl is-active --quiet apache2; then
    success "Apache      : RUNNING"
else
    error "Apache      : FAILED"
fi

# MariaDB
if systemctl is-active --quiet mariadb; then
    success "MariaDB     : RUNNING"
else
    error "MariaDB     : FAILED"
fi

# VHost
if [[ -f "$VHOST" ]]; then
    success "VirtualHost : CREATED"
else
    error "VirtualHost : FAILED"
fi

# Webroot
if [[ -d "$WEBROOT" ]]; then
    success "Webroot     : CREATED"
else
    error "Webroot     : FAILED"
fi

# ------------------------------------------------------------
# SELESAI
# ------------------------------------------------------------

echo ""
echo "========================================"
echo "       INSTALASI SELESAI"
echo "========================================"
echo ""
echo "Domain       : http://$DOMAIN"
echo "Web Root     : $WEBROOT"
echo "Linux User   : $USERNAME"
echo "SSH Port     : $SSHPORT"
echo ""
echo "PHP          : $PHP_VERSION"
echo "Apache       : $APACHE_VERSION"
echo "MariaDB      : $MARIADB_VERSION_OUTPUT"
echo ""
echo "SSH Login:"
echo "ssh -p $SSHPORT $USERNAME@IP_SERVER"
echo ""
echo "PHP Info:"
echo "http://$DOMAIN/info.php"
echo ""
echo "========================================"
```
